# PostgreSQL administrado (Render, Neon, Supabase, etc.)
DATABASE_URL=postgresql://usuario:contrasena@host:5432/qr_salud
# Genera un secreto largo y aleatorio (mínimo 32 caracteres)
SESSION_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
NODE_ENV=development
PORT=3000
# Opcional: PGSSLMODE=disable solo para PostgreSQL local sin TLS
